# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
# Random string, at least 16 chars; signs the GitHub install `state` and other app tokens
APP_SECRET=
# Optional: 32 random bytes, base64 (`openssl rand -base64 32`). Encrypts secrets at rest (BYO LLM keys, SSO secrets).
# When unset, a key is derived from APP_SECRET.
ENCRYPTION_KEY=
# debug | info | warn | error (default info; tests default to warn)
LOG_LEVEL=info

# PostgreSQL (with pgvector). Compose overrides the host to `postgres` inside the network.
POSTGRES_USER=openreview
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openreview
DATABASE_URL=postgres://openreview:change-me@localhost:5432/openreview

# Redis (BullMQ). Compose overrides the host to `redis` inside the network.
REDIS_URL=redis://localhost:6379

# Built-in auth (sessions in Postgres)
# Days a session stays valid; active sessions slide forward (at most once an hour)
SESSION_TTL_DAYS=30
# Local development / Playwright only: adds "Continue as local developer" to /sign-in.
# Refused when NODE_ENV=production.
AUTH_DEV_LOGIN=false

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM; literal "\n" escapes are accepted
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
# Web origin of GitHub (GitHub Enterprise Server: https://ghe.example.com; its API is https://ghe.example.com/api/v3)
GITHUB_WEB_URL=https://github.com
# The GitHub App's OAuth client id/secret, used for "Sign in with GitHub".
# In the App settings set the Callback URL to $APP_URL/api/auth/github/callback and the Setup URL to
# $APP_URL/api/github/callback; leave "Request user authorization (OAuth) during installation" off.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Name users @mention in PR comments to ask questions
BOT_MENTION=openreview

# LLM (every model call goes through the gateway in lib/llm).
# LLM_PROVIDER: anthropic | openai | openrouter | openai-compatible (vLLM, Ollama, LM Studio, TGI) | fake
#   openai with a non-api.openai.com LLM_BASE_URL behaves as openai-compatible.
LLM_PROVIDER=anthropic
# Default model for every task. Optional for anthropic (built-in per-task routes, default claude-opus-5-5);
# required for openai / openrouter / openai-compatible unless every task has its own LLM_MODEL_<TASK>.
LLM_MODEL=
# Endpoint override. Required for openai-compatible (e.g. http://localhost:11434/v1); optional otherwise.
LLM_BASE_URL=
# API key for the provider (anthropic falls back to ANTHROPIC_API_KEY when empty). Required for openai and openrouter.
LLM_API_KEY=
# Per-task models (override LLM_MODEL for one task). Empty = LLM_MODEL, then the built-in route.
LLM_MODEL_REVIEW=
LLM_MODEL_VERIFY=
LLM_MODEL_SUMMARY=
LLM_MODEL_CLASSIFY=
LLM_MODEL_CONTEXT=
LLM_MODEL_CHAT=
LLM_MODEL_KNOWLEDGE=
LLM_MODEL_RULES=
# Review and verify model for the fast / deep review modes (override LLM_MODEL_REVIEW / LLM_MODEL_VERIFY).
LLM_MODEL_FAST=
LLM_MODEL_DEEP=
# Per-attempt timeout in milliseconds (default 180000). Calls are not streamed, so an attempt that may generate
# many tokens (deep review: up to 16000 including thinking) gets max(LLM_TIMEOUT_MS, maxTokens / LLM_MIN_OUTPUT_TOKENS_PER_SEC).
LLM_TIMEOUT_MS=180000
# Slowest output rate (tokens/second) the per-attempt timeout allows for; default 60, 0 = use LLM_TIMEOUT_MS only
LLM_MIN_OUTPUT_TOKENS_PER_SEC=60
# Retries for transient failures (429, 5xx, 529, timeouts, network errors); default 3, max 10
LLM_MAX_RETRIES=3
# Optional prices in USD per million tokens, merged over the built-in table. Models without a price are
# recorded with an unknown cost. Example: {"my-model": {"input": 1, "output": 2, "cacheRead": 0.1, "cacheWrite": 1.25}}
LLM_PRICING_JSON=
# Lifetime of opt-in response cache entries, in hours (default 168)
LLM_CACHE_TTL_HOURS=168
# Organizations' bring-your-own LLM endpoints must be https and resolve to public addresses (SSRF guard).
# Set to true only if orgs on this instance should reach internal endpoints (http, private, loopback, link-local).
LLM_ALLOW_PRIVATE_ORG_ENDPOINTS=false
# Embeddings. EMBEDDING_PROVIDER: openai | openai-compatible (needs EMBEDDING_BASE_URL and EMBEDDING_MODEL) | fake
#   openai with a non-api.openai.com EMBEDDING_BASE_URL behaves as openai-compatible.
EMBEDDING_PROVIDER=openai
# Default for openai: text-embedding-3-small. At most 1536 dimensions.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Embedding cache rows older than this many days are re-embedded and pruned (default 90). The cache is keyed by
# (model, sha256 of the text) and shared across organizations; it holds vectors, never the text.
EMBEDDING_CACHE_TTL_DAYS=90

# Where the indexer keeps repository checkouts
REPO_CACHE_DIR=/tmp/openreview-repos
# Files larger than this many bytes are not indexed (default 512 KiB)
INDEX_MAX_FILE_BYTES=524288
# Credits one review consumes per mode (R4.1): fast / standard / deep (defaults 1 / 2 / 4)
CREDITS_FAST=1
CREDITS_STANDARD=2
CREDITS_DEEP=4
# Set to "false" to skip applying migrations when the web server starts
RUN_MIGRATIONS=true
# Concurrent jobs per worker process
WORKER_CONCURRENCY=4
# Days to keep webhook delivery records (outcomes, failures); the worker prunes older ones hourly
WEBHOOK_DELIVERY_RETENTION_DAYS=30

# Review pipeline (R6.6): a push (pull_request.synchronize) waits this long before its review starts, so a burst of
# pushes is reviewed once at the newest head (default 15000 ms)
REVIEW_DEBOUNCE_MS=15000
# A running review whose heartbeat is older than this is treated as abandoned (worker crash) and re-queued, at most
# 3 times (default 600000 ms = 10 minutes)
REVIEW_STALE_MS=600000

# Host port the app is published on by docker compose
APP_PORT=3000

# Optional: PEM bundle trusted during `docker compose build` (only behind a TLS-intercepting proxy)
EXTRA_CA_CERT=
