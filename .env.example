# Web (also synchronize SESSION_SECRET and SERVICE_SECRET to Convex)
APP_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
SESSION_SECRET=
SERVICE_SECRET=
# GitHub App; put these in Convex too (client credentials only needed by web)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional Cursor Origin App. Register callback /api/origin/callback and webhook /api/origin/webhook.
# ORIGIN_APP_ID is also needed by Convex to verify the signed webhook audience.
ORIGIN_APP_ID=
ORIGIN_APP_PRIVATE_KEY=
# Convex/CLI: exact HTTPS hostnames authorized for Origin's signed archive redirects.
# Inspect a native Origin download before approving its CDN host; no wildcards or credentials.
ORIGIN_ARCHIVE_ALLOWED_HOSTS=
# Registered commercial-cloud Forge app/environment for Bitbucket catalog remote requests (web only).
BITBUCKET_FORGE_APP_ID=
BITBUCKET_FORGE_ENVIRONMENT_ID=
# Model environment must be available to Convex and local CLI
LLM_PROVIDER=openai
# Leave empty with LLM_PROVIDER=anthropic to use claude-sonnet-5-5 (review/verify/conversation)
# and claude-haiku-5-5 (summary/knowledge). Empty with openai defaults to gpt-4.1.
LLM_MODEL=gpt-4.1
LLM_API_KEY=
# Anthropic/OpenRouter/compatible endpoints are supported; custom URL is operator-controlled.
LLM_BASE_URL=
LLM_ALLOW_LOCAL=false
# Display-only cost estimates in USD per million tokens. Zero uses the built-in price table when the
# model is known; otherwise cost is unknown (not free). Budget enforcement uses INFERENCE_PRICES instead.
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
# Optional task routing: CLASSIFY, REVIEW, VERIFY, RESOLUTION, SUMMARY, KNOWLEDGE, CONVERSATION
LLM_MODEL_REVIEW=
LLM_MODEL_VERIFY=
LLM_MODEL_SUMMARY=
LLM_MODEL_KNOWLEDGE=
LLM_MODEL_CONVERSATION=
# Output token limit (256–128000). Defaults: 6000, or 16000 for Claude and OpenAI reasoning models,
# whose thinking tokens count against it. Per task: LLM_MAX_OUTPUT_TOKENS_<TASK>, e.g. ..._SUMMARY.
LLM_MAX_OUTPUT_TOKENS=
# Native JSON-schema output on the openai/anthropic adapters (responses are always zod-validated).
LLM_STRUCTURED_OUTPUT=true
# Optional operator price table for budget enforcement and cost, overriding built-ins (USD per million):
# {"compatible:my-model":{"input":0.5,"output":1.5,"cacheRead":0.05,"cacheWrite":0.6,"baseUrl":"https://models.example.com/v1"}}
# With an active inference budget, models without a verified or configured price are refused.
INFERENCE_PRICES=
# Agentic review engine: seconds per action step before the tool loop saves state and resumes
# in a new step (60–3000; default 420, below the 600 s self-hosted action limit).
AGENT_STEP_SECONDS=
# Self-hosted deployment CLI only; do not expose the admin key to the web/client.
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Optional semantic retrieval: OpenAI-compatible embeddings, exactly 1,536 dimensions.
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_COST_PER_MILLION=0
# Docker Compose operator configuration
CONVEX_INSTANCE_NAME=openreview
CONVEX_INSTANCE_SECRET=
CONVEX_PUBLIC_BACKEND_URL=http://127.0.0.1:3210
CONVEX_PUBLIC_SITE_URL=http://127.0.0.1:3211

# Encrypt provider and integration credentials. Keep a backup for restore.
CREDENTIAL_ENCRYPTION_KEY=
# Explicit HTTPS instances allowed to receive bot credentials; comma-separated host[:port].
SCM_ALLOWED_HOSTS=
# Linear OAuth app ID, read-only PKCE; configure on both Next.js and Convex.
LINEAR_CLIENT_ID=

# Atlassian Cloud OAuth 3LO read-only Jira/Confluence app (both web and Convex).
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Slack app (optional; create it from docs/slack-app-manifest.yml). SLACK_CLIENT_ID on both
# Next.js and Convex; the secret and signing secret only on Convex (events arrive at the Convex
# HTTP endpoints /slack/events and /slack/commands).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Email notifications through Resend (optional; Convex only). Without both, email is skipped.
RESEND_API_KEY=
EMAIL_FROM=
# Notion public integration (read content only; optional). Set on both Next.js and Convex.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Cloud billing (Convex). Off unless BILLING_ENABLED=true; self-hosted installs leave it unset.
BILLING_ENABLED=
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_REVIEWS=200
BILLING_REVIEWS_PER_SEAT=100
BILLING_GRACE_DAYS=7
# Stripe test-mode keys (sk_test_…); live keys also need BILLING_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SEAT_PRICE_ID=
BILLING_ALLOW_LIVE=
