[Unit]
Description=OpenReview isolated runtime worker
Wants=network-online.target docker.service
After=network-online.target docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=openreview-runtime
Group=openreview-runtime
SupplementaryGroups=docker
WorkingDirectory=/opt/openreview
Environment=NODE_ENV=production
EnvironmentFile=-/etc/openreview/runtime-worker.env
# Install Node 24 at this path, or adjust it to the host's verified executable.
ExecStart=/usr/bin/node --import tsx /opt/openreview/scripts/runtime-worker.ts
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=78
KillMode=control-group
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
