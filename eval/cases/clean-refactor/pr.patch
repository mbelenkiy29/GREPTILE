+/**
+ * A URL slug for a title: accents removed, lowercase, runs of other characters collapsed to one dash, no leading or
+ * trailing dash, at most {@link MAX_SLUG_LENGTH} characters.
+ */
+export function slugify(title: string): string {
+  const slug = title
     .normalize("NFKD")
     .replace(/[̀-ͯ]/g, "")
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
