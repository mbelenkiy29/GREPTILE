+
+/** The notification text for a mention, looking the author up among the thread's participants. */
+export function mentionTextById(participants: User[], authorId: string, comment: string): string {
+  const author = participants.find((u) => u.id === authorId);
+  return `${author!.email.split("@")[0]} mentioned you: ${comment.slice(0, 140)}`;
+}
