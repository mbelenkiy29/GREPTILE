+
+/** POST /projects/:id/archive — archives a project. */
+export async function archiveProject(store: ProjectStore, caller: Caller, id: string) {
+  const project = await store.get(id);
+  if (!project) throw new NotFoundError(id);
+  project.archived = true;
+  await store.save(project);
+  return project;
+}
