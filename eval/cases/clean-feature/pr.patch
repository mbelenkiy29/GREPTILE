--- /dev/null
+++ b/test/progress.test.ts
@@ -0,0 +1,15 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { clamp, progressPercent } from "../src/ui/progress";
+
+test("clamp keeps values inside the range", () => {
+  assert.equal(clamp(-1, 0, 10), 0);
+  assert.equal(clamp(5, 0, 10), 5);
+  assert.equal(clamp(11, 0, 10), 10);
+});
+
+test("progressPercent never exceeds 100", () => {
+  assert.equal(progressPercent(12, 10), 100);
+  assert.equal(progressPercent(5, 10), 50);
+  assert.equal(progressPercent(1, 0), 0);
+});
