-/** Width (0-100) of a progress bar for `done` of `total` steps. */
+/** `n` limited to the range [min, max]. Bounds are constants at every call site; `min` must not exceed `max`. */
+export function clamp(n: number, min: number, max: number): number {
+  return Math.min(max, Math.max(min, n));
+}
+
+/** Width (0-100) of a progress bar for `done` of `total` steps; over-reported progress never exceeds 100. */
 export function progressPercent(done: number, total: number): number {
   if (total <= 0) return 0;
-  return Math.round((done / total) * 100);
+  return clamp(Math.round((done / total) * 100), 0, 100);
 }
diff --git a/test/progress.test.ts b/test/progress.test.ts
